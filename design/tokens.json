{
  "$comment": "Source unique des tokens Triat (Signal). Genere par tools/gen_tokens.py vers data/style.css (bloc entre marqueurs) et, plus tard, TriatTokens.kt. Ne pas recopier ces valeurs a la main.",
  "version": 1,
  "color": {
    "ground":        {"value": "#000000", "role": "fond"},
    "ground-solid":  {"value": "#050505", "role": "bureau : feuilles superposees, fenetre opaque"},
    "ground-glass":  {"value": "rgba(0, 0, 0, 0.88)", "flat": "#000000", "role": "bureau : fond de fenetre si compositeur flou"},
    "veil-1":        {"value": "rgba(255, 255, 255, 0.04)", "flat": "#0a0a0a", "role": "carte, ligne survolee"},
    "veil-2":        {"value": "rgba(255, 255, 255, 0.07)", "flat": "#121212", "role": "tuile, champ, barre de lecture"},
    "veil-3":        {"value": "rgba(255, 255, 255, 0.11)", "flat": "#1c1c1c", "role": "presse, popover, toast"},
    "veil-4":        {"value": "rgba(255, 255, 255, 0.16)", "flat": "#292929", "role": "bordure de commande secondaire"},
    "hair":          {"value": "rgba(255, 255, 255, 0.08)", "flat": "#141414", "role": "filets (rares)"},
    "bar":           {"value": "rgba(8, 8, 8, 0.72)", "flat": "#080808", "role": "bureau : bandeau de lecture"},
    "scrim":         {"value": "rgba(0, 0, 0, 0.55)", "flat": "#000000", "role": "pastille sur image"},
    "scrim-2":       {"value": "rgba(0, 0, 0, 0.62)", "flat": "#000000", "role": "ligne de paroles sur video"},
    "shadow":        {"value": "rgba(0, 0, 0, 0.5)", "flat": "#000000", "role": "ombre de popover"},
    "ink-max":       {"value": "#FFFFFF", "role": "blanc plein : titres forts, QR"},
    "ink":           {"value": "#F2F2F2", "role": "texte principal, point allume"},
    "ink-2":         {"value": "#B3B3B3", "role": "texte secondaire fort"},
    "ink-3":         {"value": "#8C8C8C", "role": "meta, etiquettes (texte >= 11 px)"},
    "ink-4":         {"value": "#6B6B6B", "role": "decoratif ou >= 18 px seulement"},
    "dot-off":       {"value": "#2A2A2A", "role": "point eteint"},
    "disabled":      {"value": "#5A5A5A", "role": "commande desactivee (>= 3:1 pour l'UI)"},
    "signal":        {"value": "#D71921", "role": "en direct ; jamais du texte < 18 px"},
    "signal-ink":    {"value": "#FF4D55", "role": "variante texte du signal (badge EN DIRECT)"},
    "select-bg":     {"value": "#FFFFFF", "role": "etat actif : fond"},
    "select-fg":     {"value": "#000000", "role": "etat actif : texte"},
    "danger":        {"value": "#FF6B6B", "role": "action destructive"},
    "danger-soft":   {"value": "rgba(255, 107, 107, 0.16)", "flat": "#2a1213", "role": "survol d'une action destructive"},
    "ok":            {"value": "#4FD18B", "role": "succes discret"},
    "focus":         {"value": "#FFFFFF", "role": "anneau de focus clavier (2 px, decalage 2 px)"}
  },
  "color_light": {
    "$comment": "Mode clair (V2) : non genere, non charge.",
    "ground": "#F2F2EF", "ink": "#0B0B0B", "ink-2": "#3D3D3D", "ink-3": "#5C5C5C",
    "ink-4": "#8A8A8A", "dot-off": "#D6D6D2", "select-bg": "#0B0B0B", "select-fg": "#FFFFFF",
    "signal": "#D71921"
  },
  "font": {
    "family": {
      "display": "Doto",
      "text": "Geist",
      "mono": "Geist Mono"
    },
    "role": {
      "display-xl": {"family": "display", "weight": 800, "px": 56, "sp": 44, "line": 1.0},
      "display-l":  {"family": "display", "weight": 800, "px": 36, "sp": 32, "line": 1.05},
      "display-m":  {"family": "display", "weight": 700, "px": 24, "sp": 22, "line": 1.1},
      "title-l":    {"family": "text", "weight": 600, "px": 22, "sp": 22, "line": 1.2},
      "title-m":    {"family": "text", "weight": 600, "px": 17, "sp": 18, "line": 1.25},
      "title-s":    {"family": "text", "weight": 600, "px": 15, "sp": 16, "line": 1.3},
      "body":       {"family": "text", "weight": 400, "px": 14, "sp": 15, "line": 1.45},
      "body-s":     {"family": "text", "weight": 400, "px": 13, "sp": 14, "line": 1.4},
      "meta":       {"family": "text", "weight": 500, "px": 12, "sp": 12, "line": 1.3},
      "mono":       {"family": "mono", "weight": 400, "px": 12, "sp": 12, "line": 1.2},
      "mono-s":     {"family": "mono", "weight": 500, "px": 11, "sp": 11, "line": 1.2}
    }
  },
  "space": {"s1": 4, "s2": 8, "s3": 12, "s4": 16, "s5": 24, "s6": 32, "s7": 48, "s8": 64},
  "radius": {
    "r-panel": {"desktop": 4, "android": 8},
    "r-art-s": {"desktop": 4, "android": 6},
    "r-art-l": {"desktop": 6, "android": 12},
    "r-sheet": {"desktop": 12, "android": 28},
    "r-pill":  {"desktop": 999, "android": 999}
  },
  "motion": {
    "t-fast": {"ms": 120, "curve": "ease-out"},
    "t-base": {"ms": 200, "curve": "ease-out"},
    "t-page": {"ms": 280, "curve": "cubic-bezier(0.2, 0, 0, 1)"},
    "t-art":  {"ms": 360, "curve": "ease-in-out"}
  }
}
